APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_URL=https://www.moviemercredi.com

# Get from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# DynamoDB table names (without stage suffix — serverless.yml appends it)
DYNAMODB_POLLS_TABLE=movie-mercredi-polls
DYNAMODB_VOTES_TABLE=movie-mercredi-votes
DYNAMODB_COVERS_TABLE=movie-mercredi-covers
DYNAMODB_ENDPOINT=  # Leave blank for AWS; set to http://localhost:8000 for local dev

# AWS credentials (not needed on Lambda — IAM role is used instead)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=   # Only needed for local development
AWS_SECRET_ACCESS_KEY=

# Admin password hash — generate with: php artisan admin:generate-password
ADMIN_PASSWORD_HASH=

# Laravel defaults for this stack
CACHE_DRIVER=dynamodb
# Use "cookie" locally — "array" is in-memory only and causes 419 CSRF errors across requests
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
